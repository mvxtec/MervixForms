PORT=4000
# Secret used to sign session cookies and approval links. Change in production.
SESSION_SECRET=change-me
# Public base URL used in e-mails, QR codes, signing links and Stripe redirects
BASE_URL=http://localhost:4000

# Real e-mail delivery (otherwise e-mails are only stored in the Outbox page)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WpForms <no-reply@example.com>"

# Real card payments through Stripe Checkout (test keys work). Without it payments run in simulated test mode.
STRIPE_SECRET_KEY=

# AI form builder, AI translation and the chat agent (Claude). Optional: AI_MODEL (default claude-opus-5-5)
ANTHROPIC_API_KEY=

# Local admin account for `npm run seed:admin` (Enterprise plan). Local testing only.
ADMIN_EMAIL=admin@wpforms.local
ADMIN_PASSWORD=change-me-please

# "Sign up with Google / Microsoft" buttons appear when these are set.
# Redirect URI to register: <BASE_URL>/api/auth/oauth/google/callback (or /microsoft/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional notification providers
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Who may change plans until billing is connected (comma-separated). ADMIN_EMAIL is always included.
SUPER_ADMIN_EMAILS=
# In production (NODE_ENV=production) the server refuses to start unless SESSION_SECRET is 32+ random characters:
#   openssl rand -hex 32
NODE_ENV=development

# Allow webhooks and integrations to call private/internal addresses (local development only).
# ALLOW_PRIVATE_URLS=true
