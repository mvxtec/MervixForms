{
  "name": "wpforms-glix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WpForms by GlixWordpress — self-hosted online form platform.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "setup": "npm install && npm --prefix client install",
    "test": "node --test server/test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.1",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
